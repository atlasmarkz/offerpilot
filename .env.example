# 任意 OpenAI 兼容接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# ---- 线上部署（可选，本地试用不需要）----
# 网页端读岗位：项目 URL 和 anon 公钥（可以公开，受行级安全限制只能读已审核岗位）
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 采集器同步岗位：service_role 密钥（绝不能进仓库或前端）
SUPABASE_SERVICE_KEY=
# 简历解析的用量保护（见 DEPLOY.md）
RESUME_DAILY_LIMIT=200
RESUME_PER_IP_LIMIT=5
# 登录验证码用量保护：每个 IP 每天发送次数、全站每天发送次数
AUTH_CODE_PER_IP=20
AUTH_CODE_DAILY=500

# ---- 托管版计费（自托管/本地不要设）----
# 打开后：使用站点模型（上面的 LLM_*，如 MiniMax）必须登录并扣额度；用户自带模型不受影响。
# 需要 SUPABASE_SERVICE_KEY 放在服务端环境变量里（绝不能暴露给前端）。
BILLING_ENABLED=

# ---- 支付（支付宝电脑网站支付；要先打开上面的 BILLING_ENABLED）----
# 先用支付宝开放平台的“沙箱应用”跑通，不需要营业执照；正式上线换成正式应用和正式网关。
PAYMENT_ENABLED=
ALIPAY_APP_ID=
# 应用私钥（只放服务端，绝不能提交到仓库）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（注意不是“应用公钥”）
ALIPAY_PUBLIC_KEY=
# 不填默认沙箱网关；正式：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=
# 支付宝异步通知要打到的公网地址（如 https://offerpilot-rose.vercel.app）；不填就用当前访问的域名
PAY_PUBLIC_ORIGIN=
