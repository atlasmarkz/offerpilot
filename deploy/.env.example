# 复制成 deploy/.env 再填写（.env 已被 git 忽略，绝不要提交）。改完执行 docker compose up -d 生效。

# ---- 域名（必填）：已解析到这台服务器的域名，不带 https:// ----
DOMAIN=offerpilot.example.com

# ---- 在服务器上构建时用的 npm 源（可选）：国内服务器建议 https://registry.npmmirror.com ----
# NPM_REGISTRY=https://registry.npmjs.org

# ---- 用 GitHub 构建好的镜像（可选）：不填就在服务器上构建 ----
# WEB_IMAGE=ghcr.io/atlasmarkz/offerpilot-web:latest

# ---- 数据库（Supabase，和 Vercel 上填的一样）----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 服务端密钥：能绕过所有行级安全，只放在服务器上
SUPABASE_SERVICE_KEY=

# ---- 站点自备的大模型（任意 OpenAI 兼容接口，如 MiniMax）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 用量保护 ----
RESUME_DAILY_LIMIT=200
RESUME_PER_IP_LIMIT=5
AUTH_CODE_PER_IP=20
AUTH_CODE_DAILY=500

# ---- 计费（托管版收费时打开）----
BILLING_ENABLED=

# ---- 支付（支付宝；支付功能合并进 main 之后才有用）----
# PAYMENT_ENABLED=1
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=
# 支付宝异步通知打到这里：填 https://<上面的 DOMAIN>
# PAY_PUBLIC_ORIGIN=
